# Copy to .env and edit before first run: cp .env.example .env

# --- Pelican Panel ---
PANEL_PORT=36747
APP_URL=http://localhost:36747

# --- Wings daemon ---
WINGS_PORT=36748
WINGS_SFTP_PORT=36479

# --- Database ---
DB_ROOT_PASSWORD=change-me-root
DB_DATABASE=pelicanpaneldb
DB_USERNAME=pelicanpanel
DB_PASSWORD=change-me-db

# --- Enshrouded (managed by Wings, but documented here for reference) ---
# Game port (UDP+TCP) and query port. Must match the egg variables.
# Standard Enshrouded defaults: game port 15636, query port 15637.
GAME_PORT=15636
QUERY_PORT=15637